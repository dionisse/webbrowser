# ---------------------------------------------------------------------------
# Nimbus — environment configuration
# Copy to `.env` at the repository root. Every value is optional: with an empty
# file Nimbus runs in "Local vault" mode (server-side encrypted store) and all
# cloud providers stay available but unconfigured.
# ---------------------------------------------------------------------------

# --- Core ------------------------------------------------------------------
NIMBUS_PORT=8787
NIMBUS_HOST=0.0.0.0
# Public origin of the app. Used to build OAuth redirect URLs.
NIMBUS_PUBLIC_URL=http://localhost:5173
# Secret used to encrypt provider credentials at rest (server side).
# Generate with: openssl rand -hex 32
NIMBUS_SERVER_KEY=
# Session lifetime in minutes of inactivity before forced re-lock.
NIMBUS_SESSION_TTL_MINUTES=15

# --- Google Drive ----------------------------------------------------------
# https://console.cloud.google.com/apis/credentials  (Drive API enabled)
# Redirect URI to whitelist: {NIMBUS_PUBLIC_URL}/api/cloud/oauth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Yandex Disk -----------------------------------------------------------
# https://oauth.yandex.com/  ("Yandex Disk REST API" scopes)
# Redirect URI to whitelist: {NIMBUS_PUBLIC_URL}/api/cloud/oauth/yandex/callback
YANDEX_CLIENT_ID=
YANDEX_CLIENT_SECRET=

# --- Microsoft OneDrive ----------------------------------------------------
# https://entra.microsoft.com/ → App registrations (Files.ReadWrite.All)
# Redirect URI: {NIMBUS_PUBLIC_URL}/api/cloud/oauth/onedrive/callback
ONEDRIVE_CLIENT_ID=
ONEDRIVE_CLIENT_SECRET=

# --- Proton Drive ----------------------------------------------------------
# Proton uses a private client id + SRP authentication. Provide an app
# credential pair issued by Proton, or a long-lived access token for testing.
# Redirect URI: {NIMBUS_PUBLIC_URL}/api/cloud/oauth/proton/callback
PROTON_CLIENT_ID=
PROTON_CLIENT_SECRET=
PROTON_APP_VERSION=browser-nimbus@0.1.0

# --- Generic WebDAV (pCloud, Nextcloud, Infomaniak kDrive, Yandex via DAV) --
# Only used if you pick "WebDAV" as a provider. Credentials are entered in the
# UI and encrypted at rest; nothing needed here unless you want defaults.
WEBDAV_DEFAULT_URL=

# --- Browsing engine -------------------------------------------------------
# User-Agent advertised by the cloud rendering engine.
NIMBUS_USER_AGENT=Mozilla/5.0 (X11; Linux x86_64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/126.0.0.0 Safari/537.36
# Maximum bytes fetched per document before truncation (protects memory).
NIMBUS_MAX_DOCUMENT_BYTES=8000000
# Ephemeral in-memory page cache TTL, in seconds. 0 disables caching.
NIMBUS_CACHE_TTL_SECONDS=120
# Comma-separated host suffixes that the engine refuses to proxy.
NIMBUS_BLOCKED_HOSTS=localhost,127.0.0.1,169.254.169.254,metadata.google.internal
